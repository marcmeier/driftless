// The bar's widgets and their default order: the source of every widget. The widget manager
// (SUPER + SHIFT + B, scripts/widgets.py) hides and moves them per machine and saves that in
// ~/.local/state/driftless-shell/layout.json; scripts/bar_layout.py and services/BarLayout.qml both read this
// file. A widget missing from a saved order (new here) goes in right after the widget before it.
// Groups are drawn as one pill; their members can be hidden one by one, they move with the group.
// The right side runs from what comes and goes (next to the clock) to what always stays (at the edge),
// so a pill that appears or grows pushes only the passing things aside; each pill holds one kind of thing.
// First of all the privacy indicator (custom/privacy): only there while an app records the microphone,
// uses the camera or shares the screen.
{
    "modules-left": ["group/user", "group/workspaces", "custom/window"],
    "modules-center": ["group/datetime"],
    "modules-right": ["custom/privacy", "group/media", "group/tray", "group/pending", "group/claude", "group/status", "group/session"],

    "groups": {
        // avatar and name; a click opens the settings (bar/SettingsPopup.qml)
        "group/user": ["custom/avatar", "custom/username"],
        // your voice: ask Claude (the bubble grows out of this button), dictation, and how much of
        // Claude is left
        "group/claude": ["custom/ask", "custom/dictate", "custom/claude"],
        // one island: time and date · weather · the next event
        "group/datetime": ["clock", "custom/weather", "custom/calendar"],
        // how this machine is connected: network, Bluetooth, output (with the microphones in its popup), battery
        "group/status": ["network", "bluetooth", "pulseaudio", "battery"],
        // the apps' own icons, apart from the kit's monochrome ones, next to the media (apps too); folded
        // behind an arrow, only the pinned ones stay in the bar
        "group/tray": ["tray"],
        // what waits for you: updates, the sync; gone while there is nothing to do
        "group/pending": ["custom/updates", "custom/sync"],
        // you and the session, always in the same place at the edge: notifications (do not disturb),
        // keep awake, power
        "group/session": ["custom/notifications", "idle_inhibitor", "custom/power"]
    },

    // the compact bar (narrow screens) has the same pills with fewer words; these groups lose members
    "compact": {
        "group/user": ["custom/avatar"]
    }
}
