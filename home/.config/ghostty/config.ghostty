# Matches the shell (bar, notifications, lock screen) and walker. Stock config was empty: config.ghostty.bak-default

font-family = JetBrainsMono Nerd Font
font-size = 12

window-padding-x = 8
window-padding-y = 6
window-decoration = none
confirm-close-surface = false
# no toast on every reload (the look sends USR2 when it changes)
app-notifications = no-config-reload

cursor-style = bar
cursor-style-blink = false
mouse-hide-while-typing = true

# colours: the plain look, dark or light, with its one accent (generated by ~/.config/theme/apply.py)
config-file = ../theme/ghostty-colors
